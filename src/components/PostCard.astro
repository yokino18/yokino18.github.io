---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { formatDate } from '../lib/utils';

interface Props {
  post: {
    slug: string;
    data: {
      title: string;
      description?: string;
      pubDate: Date;
      category: string;
      tags: string[];
      cover?: ImageMetadata;
    };
  };
}
const { post } = Astro.props;
const { data } = post;
const href = `/posts/${post.slug}/`;
---
<article class="card-base card-hover onload-animation flex flex-col overflow-hidden">
  {data.cover && (
    <a href={href} class="block aspect-[2/1] w-full overflow-hidden">
      <Image
        src={data.cover}
        alt={data.title}
        widths={[400, 640, 900]}
        sizes="(min-width: 1280px) 660px, (min-width: 768px) 50vw, 100vw"
        format="webp"
        quality={78}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover transition duration-500 hover:scale-105"
      />
    </a>
  )}
  <div class="flex flex-1 flex-col p-5">
    <div class="mb-2 flex flex-wrap items-center gap-2 text-xs" style="color: var(--muted)">
      <a href={`/archive/?category=${encodeURIComponent(data.category)}`} class="badge">{data.category}</a>
      <time datetime={formatDate(data.pubDate)}>{formatDate(data.pubDate)}</time>
    </div>
    <h2 class="text-xl font-bold leading-snug">
      <a href={href} class="transition hover:underline" style="color: var(--text)">{data.title}</a>
    </h2>
    {data.description && (
      <p class="mt-2 line-clamp-3 text-sm" style="color: var(--muted)">{data.description}</p>
    )}
    <div class="mt-auto flex flex-wrap gap-1.5 pt-4">
      {data.tags.map((tag) => (
        <a href={`/archive/?tag=${encodeURIComponent(tag)}`} class="badge">#{tag}</a>
      ))}
    </div>
  </div>
</article>
