---
interface Props { items: { name: string; count: number }[] }
const { items } = Astro.props;
---
<div class="card-base p-5 onload-animation">
  <p class="widget-title">分类</p>
  <ul class="mt-3 space-y-2 text-sm">
    {items.map((c) => (
      <li>
        <a href={`/archive/?category=${encodeURIComponent(c.name)}`} class="flex items-center justify-between rounded-lg px-2 py-1 transition hover:bg-primary/10">
          <span>{c.name}</span>
          <span class="badge">{c.count}</span>
        </a>
      </li>
    ))}
  </ul>
</div>
