---
import { SITE } from '../../lib/site';
interface Props { astroVersion: string; nodeVersion: string; pkgManager: string; buildTime: string; platform: string; }
const { astroVersion, nodeVersion, pkgManager, buildTime, platform } = Astro.props;
const rows = [
  ['博客版本', SITE.blogVersion],
  ['文章许可', SITE.license],
  ['站点域名', SITE.domain],
  ['Astro', astroVersion],
  ['Node', nodeVersion],
  ['包管理器', pkgManager],
  ['构建时间', buildTime],
  ['系统信息', platform],
  // 探测不到的项（值为 —）直接不显示，避免露出占位符
].filter(([, value]) => value && value !== '—') as [string, string][];
---
<div class="card-base p-5 onload-animation">
  <p class="widget-title">站点信息</p>
  <ul class="mt-3 space-y-1.5 text-sm">
    {rows.map(([label, value]) => (
      <li class="flex items-center justify-between gap-2 rounded-lg px-2 py-1">
        <span style="color: var(--muted)">{label}</span>
        <span class="text-right font-semibold">{value}</span>
      </li>
    ))}
  </ul>
</div>
