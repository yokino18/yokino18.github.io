---
interface Props { items: { name: string; count: number }[] }
const { items } = Astro.props;
---
<div class="card-base p-5 onload-animation">
  <p class="widget-title">标签</p>
  <div class="mt-3 flex flex-wrap gap-1.5">
    {items.map((t) => (
      <a href={`/archive/?tag=${encodeURIComponent(t.name)}`} class="badge">#{t.name} <span class="opacity-70">({t.count})</span></a>
    ))}
  </div>
</div>
