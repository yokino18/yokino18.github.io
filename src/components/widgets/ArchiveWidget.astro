---
interface Props { months: { label: string; count: number }[]; total: number }
const { months, total } = Astro.props;
---
<div class="card-base p-5 onload-animation">
  <p class="widget-title">归档</p>
  <ul class="mt-3 space-y-1.5 text-sm">
    {months.map((m) => (
      <li class="flex items-center justify-between rounded-lg px-2 py-1">
        <span>{m.label}</span><span class="badge">{m.count}</span>
      </li>
    ))}
  </ul>
  <a href="/archive/" class="badge mt-3">共 {total} 篇</a>
</div>
