---
import { Image } from 'astro:assets';
import { PROFILE } from '../../lib/site';
---
<div class="card-base p-5 text-center onload-animation">
  <Image src={PROFILE.avatar} alt="avatar" width={128} height={128} class="mx-auto h-16 w-16 rounded-2xl" loading="lazy" decoding="async" />
  <p class="mt-3 text-lg font-bold">{PROFILE.name}</p>
  <p class="mt-1 text-xs" style="color: var(--muted)">{PROFILE.bio}</p>
  <a href="/about/" class="badge mt-3">了解详情</a>
</div>