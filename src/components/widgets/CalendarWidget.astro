---
interface Props { postDates: string[] }
const { postDates } = Astro.props;
const json = JSON.stringify(postDates);
---
<div class="card-base p-5 onload-animation">
  <p class="widget-title">日历</p>
  <div class="mt-3" data-calendar>
    <div class="mb-2 flex items-center justify-between">
      <button type="button" data-cal-prev class="scale-animation rounded-lg px-2 py-0.5 hover:bg-primary/10">‹</button>
      <span data-cal-title class="text-sm font-semibold"></span>
      <button type="button" data-cal-next class="scale-animation rounded-lg px-2 py-0.5 hover:bg-primary/10">›</button>
    </div>
    <div class="cal-grid">
      {['日','一','二','三','四','五','六'].map((d) => <span class="cal-cell" style="font-weight:700">{d}</span>)}
    </div>
  </div>
  <script type="application/json" data-cal-dates set:html={json}></script>
</div>
