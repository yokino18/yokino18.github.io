---
interface Props { headings: { id: string; text: string; level: number }[] }
const { headings } = Astro.props;
---
<div class="card-base p-5 onload-animation">
  <p class="widget-title">文章目录</p>
  {headings.length === 0 ? (
    <p class="mt-3 text-sm" style="color: var(--muted)">当前页面没有目录</p>
  ) : (
    <nav id="toc" class="mt-3 space-y-1 text-sm">
      {headings.map((h) => (
        <a
          href={`#${h.id}`}
          data-toc-link
          class="block rounded-lg px-2 py-1 transition hover:bg-primary/10 hover:text-primary"
          style={`margin-left: ${(h.level - 2) * 0.9}rem`}
        >{h.text}</a>
      ))}
    </nav>
  )}
</div>
