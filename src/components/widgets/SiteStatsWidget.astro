---
interface Props {
  articles: number; moments: number; categories: number; tags: number;
  words: number; uptimeDays: number; lastActivityDays: number;
}
const { articles, moments, categories, tags, words, uptimeDays, lastActivityDays } = Astro.props;
const rows = [
  ['文章', articles], ['动态', moments], ['分类', categories], ['标签', tags],
  ['总字数', words], ['运行时长', `${uptimeDays} 天`], ['最后活动', `${lastActivityDays} 天前`],
];
---
<div class="card-base p-5 onload-animation">
  <p class="widget-title">站点统计</p>
  <ul class="mt-3 space-y-1.5 text-sm">
    {rows.map(([label, value]) => (
      <li class="flex items-center justify-between rounded-lg px-2 py-1">
        <span style="color: var(--muted)">{label}</span>
        <span class="font-semibold">{value}</span>
      </li>
    ))}
  </ul>
</div>
