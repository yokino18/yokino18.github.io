---
import { Image } from 'astro:assets';
import { SITE, NAV, AVATAR } from '../lib/site';

const path = Astro.url.pathname;
function isActive(href: string): boolean {
  return href === '/' ? path === '/' : path.startsWith(href);
}
const social = [
  { name: 'GitHub', href: SITE.github },
  { name: 'QQ群', href: `https://qm.qq.com/` },
];
---
<header class="navbar">
  <div class="mx-auto flex h-14 w-full items-center gap-1 px-2 md:px-4" style="max-width: var(--page-width)">
    <a href="/" class="flex shrink-0 items-center gap-2 rounded-xl px-2 py-1 scale-animation">
      <Image src={AVATAR} alt="logo" width={64} height={64} class="h-8 w-8 rounded-lg" loading="eager" decoding="async" />
      <span class="text-lg font-bold">{SITE.shortName}</span>
    </a>
    <nav class="ml-2 hidden items-center gap-0.5 lg:flex" aria-label="主导航">
      {NAV.map((item) => (
        <a href={item.href} class:list={['navbar-link', { active: isActive(item.href) }]}>{item.name}</a>
      ))}
    </nav>
    <div class="ml-auto flex items-center gap-1">
      <button type="button" data-action="search" class="navbar-link" aria-label="搜索">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      </button>
      <button type="button" data-action="theme" class="navbar-link" aria-label="切换主题">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <button type="button" data-action="settings" class="navbar-link" aria-label="设置">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z"/></svg>
      </button>
      <a href={SITE.github} class="navbar-link hidden sm:inline-flex" aria-label="GitHub">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.75 2.69 1.25 3.34.95.1-.74.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23 2.76.11 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .31.21.67.8.56A10.52 10.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>
      </a>
      <button type="button" data-action="menu" class="navbar-link lg:hidden" aria-label="菜单">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </div>

  <!-- 移动端抽屉 -->
  <div id="mobile-menu" class="hidden border-t px-3 pb-4 pt-2 lg:hidden" style="border-color: var(--border)">
    <nav class="grid grid-cols-2 gap-1" aria-label="移动端导航">
      {NAV.map((item) => (
        <a href={item.href} class:list={['navbar-link', { active: isActive(item.href) }]}>{item.name}</a>
      ))}
    </nav>
    <div class="mt-3 flex gap-2">
      {social.map((s) => (
        <a href={s.href} target="_blank" rel="noopener" class="badge">{s.name}</a>
      ))}
    </div>
  </div>
</header>