---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchPanel from '../components/client/SearchPanel.astro';
import SettingsPanel from '../components/client/SettingsPanel.astro';
import { getEntry, render } from 'astro:content';
import { SITE } from '../lib/site';

const entry = await getEntry('pages', 'about');
const { Content } = await render(entry!);
---
<BaseLayout title="关于我" bannerTitle="关于我">
  <SearchPanel />
  <SettingsPanel />
  <div class="mx-auto max-w-3xl pb-10 pt-6">
    <article class="card-base markdown-body p-6 md:p-10">
      <Content />
    </article>
  </div>
</BaseLayout>
