---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchPanel from '../components/client/SearchPanel.astro';
import SettingsPanel from '../components/client/SettingsPanel.astro';
import { getAllPosts } from '../lib/stats';
import { formatDate } from '../lib/utils';

const posts = await getAllPosts();
const years = new Map<number, { label: string; posts: typeof posts }[]>();
for (const p of posts) {
  const year = p.data.pubDate.getFullYear();
  const month = formatDate(p.data.pubDate).slice(0, 7);
  if (!years.has(year)) years.set(year, []);
  const arr = years.get(year)!;
  let group = arr.find((g) => g.label === month);
  if (!group) { group = { label: month, posts: [] }; arr.push(group); }
  group.posts.push(p);
}
const sorted = [...years.entries()].sort((a, b) => b[0] - a[0]);
---
<BaseLayout title="归档" bannerTitle="归档">
  <SearchPanel />
  <SettingsPanel />
  <div class="mx-auto max-w-3xl space-y-6 pb-10 pt-6">
    <div id="filter-notice" class="card-base hidden items-center justify-between gap-3 p-4 text-sm">
      <span style="color: var(--muted)">正在筛选：<span data-filter-text></span></span>
      <a href="/archive/" class="badge">清除筛选</a>
    </div>
    <p id="filter-empty" class="card-base hidden p-8 text-center text-sm" style="color: var(--muted)">没有符合条件的文章</p>
    {sorted.map(([year, groups]) => (
      <section class="card-base p-6" data-archive-section>
        <h2 class="text-xl font-bold">{year} 年</h2>
        {groups.map((g) => (
          <div class="mt-4">
            <h3 class="widget-title">{g.label} <span class="badge">{g.posts.length}</span></h3>
            <ul class="mt-2 space-y-2">
              {g.posts.map((p) => (
                <li class="flex items-baseline justify-between gap-4 text-sm" data-archive-item data-category={p.data.category} data-tags={p.data.tags.join(',')}>
                  <a href={`/posts/${p.id}/`} class="truncate hover:text-primary hover:underline">{p.data.title}</a>
                  <span class="shrink-0" style="color: var(--muted)">{formatDate(p.data.pubDate)}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    ))}
  </div>
  <script is:inline>
    (function () {
      var params = new URLSearchParams(location.search);
      var cat = params.get('category') || '';
      var tag = params.get('tag') || '';
      if (!cat && !tag) return;
      var shown = 0;
      document.querySelectorAll('[data-archive-item]').forEach(function (el) {
        var ok = (!cat || el.dataset.category === cat) && (!tag || el.dataset.tags.split(',').indexOf(tag) !== -1);
        el.style.display = ok ? '' : 'none';
        if (ok) shown++;
      });
      document.querySelectorAll('[data-archive-section]').forEach(function (sec) {
        var items = sec.querySelectorAll('[data-archive-item]');
        var any = Array.prototype.some.call(items, function (el) { return el.style.display !== 'none'; });
        if (!any) sec.style.display = 'none';
      });
      var notice = document.getElementById('filter-notice');
      if (notice) {
        notice.classList.remove('hidden');
        notice.classList.add('flex');
        var txt = notice.querySelector('[data-filter-text]');
        if (txt) txt.textContent = (cat ? '分类：' + cat + ' ' : '') + (tag ? '标签：' + tag : '');
      }
      var empty = document.getElementById('filter-empty');
      if (empty && shown === 0) empty.classList.remove('hidden');
    })();
  </script>
</BaseLayout>