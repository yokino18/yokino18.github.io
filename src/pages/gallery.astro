---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchPanel from '../components/client/SearchPanel.astro';
import SettingsPanel from '../components/client/SettingsPanel.astro';
import albums from '../data/gallery.json';
import type { GalleryAlbum } from '../lib/types';
---
<BaseLayout title="相册" bannerTitle="相册">
  <SearchPanel />
  <SettingsPanel />
  <div class="mx-auto max-w-5xl pb-10 pt-6">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 stagger">
      {(albums as GalleryAlbum[]).map((album) => (
        <a href={`/gallery/${album.slug}/`} class="card-base card-hover group overflow-hidden">
          <div class="relative aspect-[4/3] overflow-hidden">
            <img src={album.cover} alt={album.title} loading="lazy" decoding="async" width="800" height="450" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
            {album.password && (
              <span class="absolute right-2 top-2 rounded-full bg-(--scrim) px-2 py-0.5 text-xs text-(--deep-text)">🔒 加密</span>
            )}
          </div>
          <div class="p-4">
            <p class="font-bold">{album.title}</p>
            <p class="mt-1 text-sm line-clamp-2" style="color: var(--muted)">{album.description}</p>
            <p class="mt-2 text-xs" style="color: var(--muted)">{album.images.length} 张图片</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
