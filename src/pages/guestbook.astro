---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchPanel from '../components/client/SearchPanel.astro';
import SettingsPanel from '../components/client/SettingsPanel.astro';
import Comments from '../components/client/Comments.astro';
import { SITE } from '../lib/site';
---
<BaseLayout title="留言板" bannerTitle="留言板">
  <SearchPanel />
  <SettingsPanel />
  <div class="mx-auto max-w-3xl space-y-4 pb-10 pt-6">
    <div class="card-base p-6">
      <p class="widget-title">欢迎留言</p>
      <p class="mt-3 text-sm leading-relaxed" style="color: var(--muted)">
        欢迎在 {SITE.title} 留言！可以聊聊学习、生活、技术，或者给我提建议。
      </p>
      <div class="mt-3 rounded-xl p-4 text-sm leading-relaxed" style="background: var(--page-bg); color: var(--muted)">
        <p class="font-bold" style="color: var(--text)">使用说明</p>
        <ul class="mt-2 list-inside list-disc space-y-1">
          <li>请友善发言，尊重他人；</li>
          <li>评论按页面区分主题，文章页的评论互不干扰；</li>
          <li>演示模式数据保存在浏览器本地；配置 Waline 服务后即为在线评论。</li>
        </ul>
      </div>
    </div>
    <Comments title="留言板" storageKey="guestbook" />
  </div>
</BaseLayout>