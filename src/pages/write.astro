---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchPanel from '../components/client/SearchPanel.astro';
import SettingsPanel from '../components/client/SettingsPanel.astro';
import { SITE } from '../lib/site';
---
<BaseLayout title="写作管理" bannerTitle="写作管理">
  <SearchPanel />
  <SettingsPanel />
  <div class="mx-auto max-w-6xl pb-10 pt-6" id="write-app" data-pass={SITE.writePassword}>
    <!-- 登录 -->
    <div id="write-login" class="card-base mx-auto max-w-sm p-8 text-center">
      <p class="text-4xl">✍️</p>
      <p class="mt-3 font-bold">写作管理</p>
      <p class="mt-1 text-xs" style="color: var(--muted)">仅限站点所有者（演示密码：{SITE.writePassword}）</p>
      <form class="mt-5 space-y-3">
        <input id="write-pass" type="password" placeholder="密码" class="w-full rounded-lg border px-3 py-2 text-sm outline-none focus:border-primary" style="background: var(--page-bg); border-color: var(--border)" />
        <button type="submit" class="w-full rounded-lg py-2 text-sm text-(--btn-content)" style="background: var(--primary)">登录</button>
      </form>
      <p id="write-login-msg" class="mt-2 text-xs" style="color: var(--primary)"></p>
    </div>

    <!-- 编辑器 -->
    <div id="write-editor" class="hidden space-y-4">
      <div class="card-base flex flex-wrap items-center gap-2 p-4">
        <input id="md-title" type="text" placeholder="文章标题" class="min-w-40 flex-1 rounded-lg border px-3 py-2 text-sm outline-none focus:border-primary" style="background: var(--page-bg); border-color: var(--border)" />
        <input id="md-slug" type="text" placeholder="slug（文件名）" class="w-44 rounded-lg border px-3 py-2 text-sm outline-none focus:border-primary" style="background: var(--page-bg); border-color: var(--border)" />
        <input id="md-category" type="text" placeholder="分类" class="w-28 rounded-lg border px-3 py-2 text-sm outline-none focus:border-primary" style="background: var(--page-bg); border-color: var(--border)" />
        <input id="md-tags" type="text" placeholder="标签（逗号分隔）" class="w-48 rounded-lg border px-3 py-2 text-sm outline-none focus:border-primary" style="background: var(--page-bg); border-color: var(--border)" />
        <button type="button" id="write-save" class="badge">保存草稿</button>
        <button type="button" id="write-export" class="badge">导出 .md</button>
        <button type="button" id="write-copy" class="badge">复制 Markdown</button>
      </div>
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        <div class="card-base flex min-h-[60vh] flex-col overflow-hidden">
          <p class="border-b px-4 py-2 text-xs font-semibold" style="color: var(--muted); border-color: var(--border)">Markdown 编辑</p>
          <textarea id="md-input" class="editor-textarea h-full min-h-[56vh] w-full resize-none p-4 outline-none" placeholder="# 在这里写文章……&#10;&#10;支持 Markdown 语法，右侧实时预览。"></textarea>
        </div>
        <div class="card-base flex min-h-[60vh] flex-col overflow-hidden">
          <p class="border-b px-4 py-2 text-xs font-semibold" style="color: var(--muted); border-color: var(--border)">实时预览</p>
          <div id="md-preview" class="preview-body h-full min-h-[56vh] w-full overflow-y-auto p-4"></div>
        </div>
      </div>
      <div class="card-base p-4">
        <p class="widget-title">草稿箱</p>
        <ul id="draft-list" class="mt-3 space-y-1.5 text-sm"></ul>
      </div>
      <div class="card-base p-4">
        <p class="widget-title">发布说明</p>
        <ol class="mt-2 list-inside list-decimal space-y-1 text-sm" style="color: var(--muted)">
          <li>点击“导出 .md”或“复制 Markdown”，把内容保存为 <code>src/content/posts/&lt;slug&gt;.md</code>；</li>
          <li>将文件提交到 Git 仓库并推送（例如 <code>git add . && git commit -m "post: 标题" && git push</code>）；</li>
          <li>配合 CI（GitHub Actions / Vercel 等）自动重新构建部署即可上线。</li>
        </ol>
      </div>
    </div>
  </div>
</BaseLayout>
