---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchPanel from '../components/client/SearchPanel.astro';
import SettingsPanel from '../components/client/SettingsPanel.astro';
import { SITE } from '../lib/site';

const links = [
  { name: 'GitHub', description: '我的开源项目与代码仓库', href: SITE.github, external: true },
  { name: 'QQ 群', description: '加入交流群一起聊天', href: 'https://qm.qq.com/', external: true },
  { name: 'RSS 订阅', description: '订阅本站最新文章', href: '/rss.xml', external: false },
  { name: '友链', description: '看看我的朋友们', href: '/friends/', external: false },
  { name: '关于我', description: '了解更多关于我的信息', href: '/about/', external: false },
];
---
<BaseLayout title="链接" bannerTitle="链接">
  <SearchPanel />
  <SettingsPanel />
  <div class="mx-auto max-w-4xl space-y-6 pb-10 pt-6">
    <div class="card-base p-6 onload-animation">
      <p class="widget-title">常用链接</p>
      <p class="mt-3 text-sm leading-relaxed" style="color: var(--muted)">
        这里整理了本站常用入口与外部链接，欢迎收藏使用。
      </p>
    </div>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 stagger">
      {links.map((l) => (
        <a
          href={l.href}
          target={l.external ? '_blank' : undefined}
          rel={l.external ? 'noopener' : undefined}
          class="card-base card-hover flex flex-col gap-2 p-5 onload-animation"
        >
          <p class="font-bold">{l.name}</p>
          <p class="text-sm" style="color: var(--muted)">{l.description}</p>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>