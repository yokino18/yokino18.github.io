---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SearchPanel from '../../components/client/SearchPanel.astro';
import SettingsPanel from '../../components/client/SettingsPanel.astro';
import albums from '../../data/gallery.json';
import type { GalleryAlbum } from '../../lib/types';

export function getStaticPaths() {
  return (albums as GalleryAlbum[]).map((album) => ({
    params: { album: album.slug },
    props: { album },
  }));
}
const { album } = Astro.props;
const isLocked = Boolean(album.password);
---
<BaseLayout title={album.title} bannerTitle={album.title}>
  <SearchPanel />
  <SettingsPanel />
  <div class="mx-auto max-w-5xl space-y-4 pb-10 pt-6">
    <div class="card-base p-6">
      <p class="text-sm" style="color: var(--muted)">{album.description} · {album.images.length} 张图片</p>
    </div>

    {isLocked && (
      <div class="card-base p-8 text-center" data-album-lock data-album-pass={album.password}>
        <p class="text-4xl">🔒</p>
        <p class="mt-3 font-bold">该相册已加密</p>
        <p class="mt-1 text-sm" style="color: var(--muted)">请输入密码查看（演示密码：casto）</p>
        <form class="mx-auto mt-4 flex max-w-xs gap-2">
          <input type="password" placeholder="密码" class="w-full rounded-lg border px-3 py-2 text-sm outline-none focus:border-primary" style="background: var(--page-bg); border-color: var(--border)" />
          <button type="submit" class="shrink-0 rounded-lg px-4 text-sm text-(--btn-content)" style="background: var(--primary)">解锁</button>
        </form>
        <p data-album-msg class="mt-2 text-xs" style="color: var(--primary)"></p>
      </div>
    )}

    <div class={isLocked ? 'hidden' : ''} data-album-content>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3 stagger">
        {album.images.map((img) => (
          <img src={img.src} alt={img.alt} loading="lazy" decoding="async" width="800" height="600" class="gallery-img aspect-[4/3] w-full cursor-zoom-in rounded-xl object-cover transition duration-300 hover:opacity-90" />
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
