---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SearchPanel from '../../components/client/SearchPanel.astro';
import SettingsPanel from '../../components/client/SettingsPanel.astro';
import albums from '../../data/gallery.json';
import type { GalleryAlbum } from '../../lib/types';
const list = albums as GalleryAlbum[];
const json = JSON.stringify(list, null, 2);
---
<BaseLayout title="相册管理" bannerTitle="相册管理">
  <SearchPanel />
  <SettingsPanel />
  <div class="mx-auto max-w-3xl space-y-4 pb-10 pt-6">
    <section class="card-base p-6">
      <p class="widget-title">相册管理</p>
      <p class="mt-3 text-sm leading-relaxed" style="color: var(--muted)">
        1. 将图片放入 <code>public/gallery/</code> 目录；<br />
        2. 编辑 <code>src/data/gallery.json</code>，新增或修改相册条目；<br />
        3. 如需加密相册，给条目添加 <code>password</code> 字段（前端演示用）；<br />
        4. 重新构建即可发布。
      </p>
    </section>
    <section class="card-base p-6">
      <p class="widget-title">相册列表</p>
      <ul class="mt-3 space-y-2 text-sm">
        {list.map((a) => (
          <li class="flex items-center justify-between rounded-lg px-3 py-2" style="background: var(--page-bg)">
            <span class="font-semibold">{a.title}</span>
            <span class="text-xs" style="color: var(--muted)">{a.images.length} 张{a.password ? ' · 加密' : ''}</span>
          </li>
        ))}
      </ul>
    </section>
    <section class="card-base p-6">
      <p class="widget-title">gallery.json 预览</p>
      <pre class="mt-3 max-h-80 overflow-auto rounded-xl p-4 text-xs leading-relaxed" style="background: var(--code-bg); color: var(--code-fg)">{json}</pre>
      <button type="button" data-copy-json class="badge mt-4">复制 JSON</button>
    </section>
  </div>
  <script>
    document.querySelector('[data-copy-json]')?.addEventListener('click', async () => {
      const el = document.querySelector('pre');
      try { await navigator.clipboard.writeText(el?.textContent || ''); } catch { /* ignore */ }
    });
  </script>
</BaseLayout>
