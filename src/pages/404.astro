---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404" bannerTitle="页面不存在" noBanner>
  <div class="flex min-h-[50vh] items-center justify-center">
    <div class="card-base p-10 text-center">
      <p class="text-6xl font-bold" style="color: var(--primary)">404</p>
      <p class="mt-4">你访问的页面不存在或已被移除。</p>
      <a href="/" class="badge mt-6 text-sm">返回主页</a>
    </div>
  </div>
</BaseLayout>
